@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> signInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ED Station Database</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=Lilita+One&family=Orbitron:wght@400..900&family=Rubik+Mono+One&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EDStationDatabase.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-primary box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-white fw-bold" asp-area="" asp-controller="Home" asp-action="Index">EDStationDatabase</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="StationBookmarks" asp-action="bookmarks">Station Bookmarks</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Edsm" asp-action="GetStationsInSystem" asp-route-systemName="Sol">Search Stations</a>
                        </li>
                        @if (signInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="Admin" asp-controller="User" asp-action="Index">Manage Users</a>
                                </li>
                            }
                            <li class="nav-item ms-auto">
                                <div class="d-flex align-items-center">
                                    <span class="text-light me-2">Welcome, @User.Identity.Name</span>
                                    <form method="post" asp-action="Logout" asp-controller="Account" asp-area="">
                                        <input type="submit" value="Log Out" class="nav-link text-white" />
                                    </form>
                                </div>
                            </li>
                        }
                        else
                        {
                            var action = ViewContext.RouteData.Values["action"]?.ToString();

                            <li class="nav-item ms-auto @(action == "Register" ? "active" : "")">
                                <a asp-action="Register" asp-controller="Account" asp-area="" class="nav-link text-white">Register</a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Login" asp-controller="Account" asp-area="" class="nav-link text-white">Log In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-black footer text-muted bg-primary mt-auto">
        <div class="container mt-2">
            &copy; 2025 - Liam Hutton @*- <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>*@
		<div>
            This site uses the API provided by <a href="https://www.edsm.net/en/api-system-v1">EDSM</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
