@model UserViewModel

@{
    ViewData["Title"] = " | Manage Users";
}

<div class="d-flex justify-content-center mb-4">
    <div class="card mx-auto" style="width: 40%;">
        <div class="card-body">
            <h1 class="card-title">Manage Users</h1>

            <table class="card-body table table-bordered table-striped table-sm">
                <thead>
                    <tr class="text-center">
                        <th>Username</th>
                        <th>Roles</th>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Count() == 0)
                    {
                        <tr><td colspan="5" class="text-center align-middle">There are no user accounts.</td></tr>
                    }
                    else
                    {
                        @foreach (User user in Model.Users)
                        {
                            <tr class="text-center align-middle">
                                <td class="align-middle">@user.UserName</td>

                                <td class="align-middle">
                                    @foreach (string roleName in user.RoleNames)
                                    {
                                        <div>@roleName</div>
                                    }
                                </td>
                                <td class="align-middle">
                                    <form method="post" asp-action="Delete" asp-route-id="@user.Id">
                                        <button type="submit" class="btn btn-danger" style="width: 100%">Delete User</button>
                                    </form>
                                </td>
                                <td class="align-middle">
                                    @if (!user.RoleNames.Contains("Admin"))
                                    {
                                        <form method="post" asp-action="AddToAdmin" asp-route-id="@user.Id">
                                            <button type="submit" class="btn btn-info" style="width: 100%">Add To Admin</button>
                                        </form>
                                    }
                                </td>
                                <td class="align-middle">
                                    <form method="post" asp-action="RemoveFromAdmin" asp-route-id="@user.Id">
                                        <button type="submit" class="btn btn-danger" style="width: 100%">Remove From Admin</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center mb-4">
    <div class="card mx-auto" style="width: 40%;">
        <div class="card-body">
            <h1 class="card-title">Manage Roles</h1>

            @if (Model.Roles.Count() == 0)
            {
                <form method="post" asp-action="CreateAdminRole">
                    <button type="submit" class="btn btn-info">Create Admin Role</button>
                </form>
            }
            else
            {
                <table class="table table-bordered table-striped table-sm">
                    <thead>
                        <tr class="text-center">
                            <th class="align-middle">Role</th>
                            <th class="align-middle"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model.Roles)
                        {
                            <tr class="text-center align-middle">
                                <td class="align-middle">@role.Name</td>
                                <td class="align-middle">
                                    <form method="post" asp-action="DeleteRole" asp-route-id="@role.Id">
                                        <button type="submit" class="btn btn-danger" style="width: 100%">Delete Role</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>